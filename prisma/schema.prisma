generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  referralCode String  @unique
  referredById String?
  referredBy   User?   @relation("Referrals", fields: [referredById], references: [id])
  referrals    User[]  @relation("Referrals")

  referralBonusesGiven    ReferralBonus[] @relation("ReferralBonusesGiven")
  referralBonusReceived   ReferralBonus?  @relation("ReferralBonusReceived")

  deposits    Deposit[]
  withdrawals Withdrawal[]
  investments Investment[]
  balance     Balance?
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model AdminWallet {
  id        String   @id @default(cuid())
  coin      String
  network   String
  address   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deposits  Deposit[]

  @@unique([coin, network])
  @@map("admin_wallets")
}

enum DepositStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model Deposit {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  adminWalletId String
  adminWallet   AdminWallet   @relation(fields: [adminWalletId], references: [id])
  txHash        String
  amount        Decimal
  usdValueAtConfirmation Decimal?
  status        DepositStatus @default(PENDING)
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  transaction   Transaction?
  referralBonus ReferralBonus?

  @@unique([txHash, adminWalletId])
  @@map("deposits")
}

enum WithdrawalStatus {
  PENDING
  PROCESSED
  REJECTED
}

model Withdrawal {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id])
  amountUsd  Decimal
  coin       String
  address    String
  coinAmount Decimal?
  status     WithdrawalStatus @default(PENDING)
  txHash     String?
  reviewedAt DateTime?
  reviewNote String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  transaction Transaction?

  @@map("withdrawals")
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  INVESTMENT
  PAYOUT
  REFERRAL_BONUS
}

model Transaction {
  id        String          @id @default(cuid())
  type      TransactionType
  createdAt DateTime        @default(now())

  entries   LedgerEntry[]

  depositId String?         @unique
  deposit   Deposit?        @relation(fields: [depositId], references: [id])

  withdrawalId String?      @unique
  withdrawal   Withdrawal?  @relation(fields: [withdrawalId], references: [id])

  investmentId String?
  investment   Investment?  @relation(fields: [investmentId], references: [id])

  referralBonusId String?    @unique
  referralBonus   ReferralBonus? @relation(fields: [referralBonusId], references: [id])

  @@map("transactions")
}

model LedgerEntry {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  account       String
  coin          String
  amount        Decimal

  createdAt     DateTime    @default(now())

  @@map("ledger_entries")
}

model Balance {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  amount    Decimal  @default(0)
  updatedAt DateTime @updatedAt

  @@map("balances")
}

model Plan {
  id           String   @id @default(cuid())
  name         String   @unique
  minAmountUsd Decimal
  maxAmountUsd Decimal
  roiPercent   Decimal
  durationDays Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  investments  Investment[]

  @@map("plans")
}

enum InvestmentStatus {
  ACTIVE
  PAID_OUT
}

model Investment {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id])
  planId       String
  plan         Plan              @relation(fields: [planId], references: [id])
  amount       Decimal
  roiPercent   Decimal
  payoutAmount Decimal?
  status       InvestmentStatus  @default(ACTIVE)
  startedAt    DateTime          @default(now())
  maturityAt   DateTime
  paidOutAt    DateTime?

  transactions Transaction[]

  @@map("investments")
}

model ReferralBonus {
  id         String   @id @default(cuid())
  referrerId String
  referrer   User     @relation("ReferralBonusesGiven", fields: [referrerId], references: [id])
  refereeId  String   @unique
  referee    User     @relation("ReferralBonusReceived", fields: [refereeId], references: [id])
  triggeringDepositId String  @unique
  triggeringDeposit   Deposit @relation(fields: [triggeringDepositId], references: [id])
  amountUsd  Decimal
  createdAt  DateTime @default(now())

  transaction Transaction?

  @@map("referral_bonuses")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_reset_tokens")
}